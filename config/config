# SC7 Rack - nested Sway config
# COSMIC sees one outer window. Everything below is tiled INSIDE it.

set $mod Mod4

default_border none
default_floating_border normal
gaps inner 5
gaps outer 0
smart_gaps off
focus_follows_mouse no
mouse_warping none
xwayland disable
output * bg #090909 solid_color
workspace 1
bindsym $mod+Shift+q exit
exec --no-startup-id "${XDG_CONFIG_HOME:-$HOME/.config}/sc7-rack/inner.sh"

# Floating window rules for dialogs and popups (native Wayland uses app_id;
# popups/menus are xdg_popup surfaces and dialogs with a parent float automatically)
for_window [app_id="com.system76.CosmicFilesDialog"] floating enable, border normal, move position center
for_window [app_id="com.system76.CosmicFilesDialogExample"] floating enable, border normal, move position center
for_window [app_id="(?i).*dialog.*"] floating enable

# Helper applications launched from COSMIC Files float instead of disrupting the 2x2 grid
for_window [app_id="com.system76.CosmicEdit"] floating enable
for_window [app_id="com.system76.CosmicViewer"] floating enable
for_window [app_id="org.gnome.FileRoller"] floating enable
for_window [app_id="org.gnome.Evince"] floating enable
for_window [app_id="org.gnome.Loupe"] floating enable
for_window [app_id="org.gnome.TextEditor"] floating enable
for_window [app_id="eog"] floating enable
for_window [app_id="gedit"] floating enable
for_window [app_id="com.system76.CosmicPlayer"] floating enable
for_window [app_id="com.system76.CosmicSettings.*"] floating enable
for_window [app_id="com.system76.Popsicle"] floating enable
for_window [app_id="io.github.celluloid_player.Celluloid"] floating enable
for_window [app_id="vlc"] floating enable
for_window [app_id="mpv"] floating enable

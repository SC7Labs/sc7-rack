diff --git a/backend/wayland/pointer.c b/backend/wayland/pointer.c
index 3e2244a..a6bd70e 100644
--- a/backend/wayland/pointer.c
+++ b/backend/wayland/pointer.c
@@ -10,6 +10,55 @@
 
 #include "pointer-gestures-unstable-v1-client-protocol.h"
 #include "relative-pointer-unstable-v1-client-protocol.h"
+#include "util/time.h"
+
+// A host drag can consume the release of the button which started it. Keep
+// the exact nested pointer which received each press so a later release can
+// balance Sway's button state even after wl_pointer.leave cleared focus.
+struct wlr_wl_pressed_button {
+	struct wlr_wl_pointer *pointer;
+	uint32_t button;
+	struct wl_list link;
+};
+
+static struct wlr_wl_pressed_button *find_pressed_button(
+		struct wlr_wl_seat *seat, uint32_t button) {
+	struct wlr_wl_pressed_button *pressed;
+	wl_list_for_each(pressed, &seat->pressed_buttons, link) {
+		if (pressed->button == button) {
+			return pressed;
+		}
+	}
+	return NULL;
+}
+
+static void release_pressed_button(struct wlr_wl_seat *seat,
+		struct wlr_wl_pressed_button *pressed, uint32_t time) {
+	struct wlr_wl_pointer *pointer = pressed->pointer;
+	uint32_t button = pressed->button;
+	wl_list_remove(&pressed->link);
+	free(pressed);
+	seat->button_is_down = !wl_list_empty(&seat->pressed_buttons);
+
+	struct wlr_pointer_button_event event = {
+		.pointer = &pointer->wlr_pointer,
+		.button = button,
+		.state = WLR_BUTTON_RELEASED,
+		.time_msec = time,
+	};
+	wl_signal_emit_mutable(&pointer->wlr_pointer.events.button, &event);
+}
+
+void wlr_wl_pointer_release_button(struct wlr_wl_seat *seat,
+		uint32_t button, uint32_t time) {
+	if (seat == NULL) {
+		return;
+	}
+	struct wlr_wl_pressed_button *pressed = find_pressed_button(seat, button);
+	if (pressed != NULL) {
+		release_pressed_button(seat, pressed, time);
+	}
+}
 

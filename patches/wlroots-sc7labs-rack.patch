+/* --- Host Data Device Listener --- */
+
+static void handle_incoming_drag_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_wl_backend *wl = wl_container_of(listener, wl, incoming_drag_destroy);
+	struct wlr_drag *drag = data;
+	if (!drag->dropped && wl->incoming_offer) {
+		// The nested grab ended without a drop. There can be no later receive.
+		host_data_offer_destroy(wl->incoming_offer);
+	}
+	wl_list_remove(&wl->incoming_drag_destroy.link);
+	wl->incoming_drag = NULL;
+	wl->incoming_offer = NULL;
+}
+
+static void data_device_handle_data_offer(void *data, struct wl_data_device *dev, struct wl_data_offer *offer) {
+	struct wlr_wl_seat *seat = data;
+	if (!seat || !seat->backend) return;
+
+	fprintf(stderr, "[sc7-dnd] host data_offer received: %p\n", (void *)offer);
+	fflush(stderr);
+
+	struct host_data_offer *ho = calloc(1, sizeof(*ho));
+	if (!ho) return;
+	ho->offer = offer;
+	ho->backend = seat->backend;
+	wl_array_init(&ho->mimes);
+	wl_data_offer_add_listener(offer, &offer_listener, ho);
+	wl_list_insert(&seat->backend->dnd_offers, &ho->link);
+}
+
+static void data_device_handle_enter(void *data, struct wl_data_device *dev,
+		uint32_t serial, struct wl_surface *surface, wl_fixed_t sx, wl_fixed_t sy,
+		struct wl_data_offer *offer) {
+	struct wlr_wl_seat *seat = data;
+	if (!seat || !seat->backend) return;
+
+	fprintf(stderr, "[sc7-dnd] host data_device ENTER: surface=%p, serial=%u, offer=%p (sx=%.1f, sy=%.1f)\n",
+		(void *)surface, serial, (void *)offer, wl_fixed_to_double(sx), wl_fixed_to_double(sy));
+	fflush(stderr);
+
+	if (seat->active_pointer == NULL) {
+		struct wlr_wl_output *output = get_wl_output_from_surface(seat->backend, surface);
+		if (output) {
+			struct wlr_wl_pointer *pointer;
+			wl_list_for_each(pointer, &seat->pointers, link) {
+				if (pointer->output == output) {
+					seat->active_pointer = pointer;
+					// Data-device enter carries a drag serial, not a
+					// wl_pointer.enter serial. Keep cursor ownership unset
+					// until a real pointer enter permits set_cursor.
+					break;
+				}
+			}
+		}
+	}
+
+	struct host_data_offer *ho = find_host_data_offer(seat->backend, offer);
+	if (seat->backend->outgoing_drag != NULL) {
+		// Our own outgoing drag moving over our window
+		fprintf(stderr, "[sc7-dnd] outgoing drag inside SC7 Rack window: hiding host icon\n");
+		fflush(stderr);
+		struct wlr_wl_outgoing_drag *od = seat->backend->outgoing_drag;
+		if (od->self_offer != ho) {
+			host_data_offer_destroy(od->self_offer);
+			od->self_offer = ho;
+		}
+		set_host_icon_visible(od, false);
+		if (ho && offer && od->wlr_drag && od->wlr_drag->source) {
+			char **mime;
+			wl_array_for_each(mime, &seat->backend->outgoing_drag->wlr_drag->source->mime_types) {
+				wl_data_offer_accept(offer, serial, *mime);
+				break;
+			}
+			if (wl_data_offer_get_version(offer) >= WL_DATA_OFFER_SET_ACTIONS_SINCE_VERSION) {
+				wl_data_offer_set_actions(offer,
+					WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY | WL_DATA_DEVICE_MANAGER_DND_ACTION_MOVE,
+					WL_DATA_DEVICE_MANAGER_DND_ACTION_MOVE);
+			}
+		}
+		if (!ho && offer) wl_data_offer_destroy(offer);
+		wlr_wl_pointer_handle_motion(seat, 0, sx, sy);
+		return;
+	}
+
+	// Incoming drag from host
+	if (!ho) {
+		fprintf(stderr, "[sc7-dnd] no matching offer found on enter for %p\n", (void *)offer);
+		fflush(stderr);
+		if (offer) wl_data_offer_destroy(offer);
+		return;
+	}
+
+	struct wlr_seat *local_seat = wlr_seat_find_by_display(seat->backend->local_display);
+	if (!local_seat) {
+		fprintf(stderr, "[sc7-dnd] no local wlr_seat found\n");
+		fflush(stderr);
+		host_data_offer_destroy(ho);
+		return;
+	}
+
+	if (local_seat->drag != NULL) {
+		fprintf(stderr, "[sc7-dnd] local seat already has active drag\n");
+		fflush(stderr);
+		host_data_offer_destroy(ho);
+		return;
+	}
+
+	struct proxy_data_source *proxy = calloc(1, sizeof(*proxy));
+	if (!proxy) {
+		host_data_offer_destroy(ho);
+		return;
+	}
+
+	proxy->host_offer = ho;
+	proxy->backend = seat->backend;
+	ho->proxy = proxy;
+	wlr_data_source_init(&proxy->base, &proxy_source_impl);
+
+	char **mime;
+	wl_array_for_each(mime, &ho->mimes) {
+		char **entry = wl_array_add(&proxy->base.mime_types, sizeof(char *));
+		if (entry) {
+			*entry = strdup(*mime);
+			fprintf(stderr, "[sc7-dnd] host -> nested proxy offering MIME: %s\n", *mime);
+			fflush(stderr);
+		}
+	}
+
+	proxy->base.actions = ho->source_actions ? ho->source_actions :
+		(WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY | WL_DATA_DEVICE_MANAGER_DND_ACTION_MOVE);
+
+	struct wlr_drag *drag = wlr_drag_create_synthetic(local_seat, &proxy->base);
+	if (!drag) {
+		wlr_data_source_destroy(&proxy->base);
+		return;
+	}
+
+	seat->backend->incoming_drag = drag;
+	seat->backend->incoming_drag_destroy.notify = handle_incoming_drag_destroy;
+	wl_signal_add(&drag->events.destroy, &seat->backend->incoming_drag_destroy);
+	seat->backend->incoming_offer = ho;
+	ho->in_use = true;
+	wlr_seat_start_pointer_drag(local_seat, drag, serial);
+
+	wlr_wl_pointer_handle_motion(seat, 0, sx, sy);
+}
+
+static void data_device_handle_leave(void *data, struct wl_data_device *dev) {
+	struct wlr_wl_seat *seat = data;
+	if (!seat || !seat->backend) return;
+
+	fprintf(stderr, "[sc7-dnd] host data_device LEAVE\n");
+	fflush(stderr);
+
+	if (seat->backend->incoming_drag) {
+		fprintf(stderr, "[sc7-dnd] incoming drag left SC7 Rack window\n");
+		fflush(stderr);
+		struct wlr_drag *drag = seat->backend->incoming_drag;
+		struct wlr_data_source *source = drag->source;
+		seat->backend->incoming_drag = NULL;
+		seat->backend->incoming_offer = NULL;
+		wlr_drag_destroy(drag);
+		wlr_data_source_destroy(source);
+	} else if (seat->backend->outgoing_drag && seat->backend->outgoing_drag->wlr_drag) {
+		fprintf(stderr, "[sc7-dnd] outgoing drag moved outside SC7 Rack window\n");
+		fflush(stderr);
+		set_host_icon_visible(seat->backend->outgoing_drag, true);
+		wlr_drag_set_focus(seat->backend->outgoing_drag->wlr_drag, NULL, 0, 0);
+		host_data_offer_destroy(seat->backend->outgoing_drag->self_offer);
+	}
+}
+
+static void data_device_handle_motion(void *data, struct wl_data_device *dev,
+		uint32_t time, wl_fixed_t sx, wl_fixed_t sy) {
+	struct wlr_wl_seat *seat = data;
+	if (!seat) return;
+
+	wlr_wl_pointer_handle_motion(seat, time, sx, sy);
+}
+
+struct incoming_drop_guard {
+	struct wl_listener drag_destroy;
+	struct wl_listener source_destroy;
+	bool drag_gone;
+	bool source_gone;
+};
+
+static void incoming_drop_drag_destroy(struct wl_listener *listener, void *data) {
+	struct incoming_drop_guard *guard = wl_container_of(listener, guard, drag_destroy);
+	guard->drag_gone = true;
+	wl_list_remove(&guard->drag_destroy.link);
+}
+
+static void incoming_drop_source_destroy(struct wl_listener *listener, void *data) {
+	struct incoming_drop_guard *guard = wl_container_of(listener, guard, source_destroy);
+	guard->source_gone = true;
+	wl_list_remove(&guard->source_destroy.link);
+}
+
+static void data_device_handle_drop(void *data, struct wl_data_device *dev) {
+	struct wlr_wl_seat *seat = data;
+	if (!seat || !seat->backend) return;
+
+	uint32_t now = (uint32_t)get_current_time_msec();
+	fprintf(stderr, "[sc7-dnd] host data_device DROP (incoming=%p, outgoing=%p)\n",
+		(void *)seat->backend->incoming_drag, (void *)seat->backend->outgoing_drag);
+	fflush(stderr);
+
+	if (seat->backend->incoming_drag) {
+		fprintf(stderr, "[sc7-dnd] drop performed inside SC7 Rack for incoming drag\n");
+		fflush(stderr);
+		struct wlr_drag *drag = seat->backend->incoming_drag;
+		struct wlr_data_source *source = drag->source;
+		bool delivered = drag->focus_client != NULL;
+		struct incoming_drop_guard guard = {0};
+		guard.drag_destroy.notify = incoming_drop_drag_destroy;
+		wl_signal_add(&drag->events.destroy, &guard.drag_destroy);
+		if (source) {
+			guard.source_destroy.notify = incoming_drop_source_destroy;
+			wl_signal_add(&source->events.destroy, &guard.source_destroy);
+		}
+		seat->backend->incoming_drag = NULL;
+		seat->backend->incoming_offer = NULL;
+		wlr_drag_drop(drag, now);
+		if (!guard.drag_gone) {
+			wl_list_remove(&guard.drag_destroy.link);
+			// The host drop ends its implicit grab. Keep the dropped data offer
+			// alive for receive/finish, but release the nested seat's drag grab.
+			wlr_drag_destroy(drag);
+		}
+		if (source && !guard.source_gone) {
+			wl_list_remove(&guard.source_destroy.link);
+		}
+		if (!delivered && source && !guard.source_gone) {
+			// wlr_drag_drop() destroyed an unfocused drag, not its source.
+			wlr_data_source_destroy(source);
+		}
+	} else if (seat->backend->outgoing_drag && seat->backend->outgoing_drag->wlr_drag) {
+		fprintf(stderr, "[sc7-dnd] drop performed inside SC7 Rack for outgoing drag\n");
+		fflush(stderr);
+		wlr_drag_drop(seat->backend->outgoing_drag->wlr_drag, now);
+	}
+}
+
+static void data_device_handle_selection(void *data, struct wl_data_device *dev,
+		struct wl_data_offer *offer) {
+	// Selection is handled out-of-band by sc7-clipboard-bridge. This data
+	// device still receives each selection offer, so release it immediately.
+	struct wlr_wl_seat *seat = data;
+	if (!seat || !seat->backend || !offer) return;
+	struct host_data_offer *ho = find_host_data_offer(seat->backend, offer);
+	if (ho) {
+		host_data_offer_destroy(ho);
+	} else {
+		wl_data_offer_destroy(offer);
+	}
+}
+
+static const struct wl_data_device_listener data_device_listener = {
+	.data_offer = data_device_handle_data_offer,
+	.enter = data_device_handle_enter,
+	.leave = data_device_handle_leave,
+	.motion = data_device_handle_motion,
+	.drop = data_device_handle_drop,
+	.selection = data_device_handle_selection,
+};
+
+void init_seat_dnd(struct wlr_wl_seat *seat) {
+	fprintf(stderr, "[sc7-dnd] init_seat_dnd: seat=%p, ddm=%p, wl_seat=%p, cur_dev=%p\n",
+		(void *)seat, (void *)seat->backend->data_device_manager,
+		(void *)seat->wl_seat, (void *)seat->wl_data_device);
+	fflush(stderr);
+	if (!seat->wl_data_device && seat->backend->data_device_manager && seat->wl_seat) {
+		seat->wl_data_device = wl_data_device_manager_get_data_device(
+			seat->backend->data_device_manager, seat->wl_seat);
+		wl_data_device_add_listener(seat->wl_data_device, &data_device_listener, seat);
+		fprintf(stderr, "[sc7-dnd] initialized data device %p for seat '%s'\n",
+			(void *)seat->wl_data_device, seat->name ? seat->name : "default");
+		fflush(stderr);
+	}
+}
+
+void finish_seat_dnd(struct wlr_wl_seat *seat) {
+	if (seat->backend) {
+		// Pointer teardown balances any outstanding press before this seat is
+		// freed. A later host source callback must not dereference that seat.
+		if (seat->backend->outgoing_drag &&
+				seat->backend->outgoing_drag->seat == seat) {
+			seat->backend->outgoing_drag->seat = NULL;
+		}
+		struct host_data_offer *ho, *tmp;
+		wl_list_for_each_safe(ho, tmp, &seat->backend->dnd_offers, link) {
+			host_data_offer_destroy(ho);
+		}
+	}
+	if (seat->wl_data_device) {
+		if (wl_data_device_get_version(seat->wl_data_device) >= 2) {
+			wl_data_device_release(seat->wl_data_device);
+		} else {
+			wl_data_device_destroy(seat->wl_data_device);
+		}
+		seat->wl_data_device = NULL;
+	}
+}

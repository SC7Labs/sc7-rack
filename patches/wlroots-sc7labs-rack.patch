+void wlr_wl_backend_start_parent_drag(struct wlr_wl_backend *wl, struct wlr_drag *drag) {
+	fprintf(stderr, "[sc7-dnd] wlr_wl_backend_start_parent_drag: wl=%p, drag=%p\n",
+		(void *)wl, (void *)drag);
+	fflush(stderr);
+
+	if (!wl || !wl->data_device_manager || !drag || !drag->source) {
+		fprintf(stderr, "[sc7-dnd] early return: wl=%p, ddm=%p, drag=%p, source=%p\n",
+			(void *)wl, (void *)(wl ? wl->data_device_manager : NULL),
+			(void *)drag, (void *)(drag ? drag->source : NULL));
+		fflush(stderr);
+		return;
+	}
+
+	struct wlr_wl_seat *seat = NULL;
+	struct wlr_wl_seat *s;
+	wl_list_for_each(s, &wl->seats, link) {
+		fprintf(stderr, "[sc7-dnd] checking seat %p ('%s'): dev=%p, btn_down=%d, serial=%u\n",
+			(void *)s, s->name ? s->name : "unnamed", (void *)s->wl_data_device,
+			s->button_is_down, s->last_button_serial);
+		fflush(stderr);
+		if (s->wl_data_device != NULL) {
+			if (s->button_is_down || !seat) {
+				seat = s;
+			}
+		}
+	}
+	if (!seat || !seat->wl_data_device) {
+		fprintf(stderr, "[sc7-dnd] no parent seat with data device available for drag! (seat=%p)\n", (void *)seat);
+		fflush(stderr);
+		return;
+	}
+
+	struct wlr_wl_output *output = NULL;
+	if (seat->active_pointer && seat->active_pointer->output) {
+		output = seat->active_pointer->output;
+	} else if (!wl_list_empty(&wl->outputs)) {
+		output = wl_container_of(wl->outputs.next, output, link);
+	}
+	if (!output || !output->surface) {
+		fprintf(stderr, "[sc7-dnd] no output surface for drag! (output=%p)\n", (void *)output);
+		fflush(stderr);
+		return;
+	}
+
+	if (seat->last_button_serial == 0) {
+		fprintf(stderr, "[sc7-dnd] missing button serial for start_drag!\n");
+		fflush(stderr);
+		return;
+	}
+
+	struct wlr_wl_outgoing_drag *od = calloc(1, sizeof(*od));
+	if (!od) return;
+
+	od->icon_fd = -1;
+	od->backend = wl;
+	od->seat = seat;
+	od->button = seat->last_button;
+	od->wlr_drag = drag;
+	od->host_source = wl_data_device_manager_create_data_source(wl->data_device_manager);
+	if (!od->host_source) {
+		fprintf(stderr, "[sc7-dnd] failed to create host data source\n");
+		fflush(stderr);
+		free(od);
+		return;
+	}
+
+	char **mime;
+	wl_array_for_each(mime, &drag->source->mime_types) {
+		wl_data_source_offer(od->host_source, *mime);
+		fprintf(stderr, "[sc7-dnd] offering MIME to host: %s\n", *mime);
+		fflush(stderr);
+	}
+
+	uint32_t actions = drag->source->actions;
+	if (actions == 0) {
+		actions = WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY | WL_DATA_DEVICE_MANAGER_DND_ACTION_MOVE;
+	}
+	wl_data_source_set_actions(od->host_source, actions);
+	wl_data_source_add_listener(od->host_source, &outgoing_source_listener, od);
+
+	od->drag_destroy.notify = handle_outgoing_drag_destroy;
+	wl_signal_add(&drag->events.destroy, &od->drag_destroy);
+
+	wl->outgoing_drag = od;
+
+	struct wl_surface *icon_surface = NULL;
+	if (drag->icon && drag->icon->surface && wl->compositor && wl->shm) {
+		icon_surface = wl_compositor_create_surface(wl->compositor);
+		if (icon_surface) {
+			od->host_icon_surface = icon_surface;
+			od->wlr_icon = drag->icon;
+
+			od->icon_commit.notify = handle_drag_icon_commit;
+			wl_signal_add(&drag->icon->surface->events.commit, &od->icon_commit);
+
+			od->icon_destroy.notify = handle_drag_icon_destroy;
+			wl_signal_add(&drag->icon->events.destroy, &od->icon_destroy);
+
+			mirror_wlr_surface_to_host(od, drag->icon->surface);
+
+			fprintf(stderr, "[sc7-dnd] initialized host drag icon surface=%p mirroring nested icon surface=%p\n",
+				(void *)icon_surface, (void *)drag->icon->surface);
+			fflush(stderr);
+		}
+	} else {
+		fprintf(stderr, "[sc7-dnd] start_parent_drag: drag has no icon (drag->icon=%p)\n",
+			(void *)drag->icon);
+		fflush(stderr);
+	}
+
+	fprintf(stderr, "[sc7-dnd] STARTING HOST DRAG on surface %p with serial %u (source=%p, icon=%p)\n",
+		(void *)output->surface, seat->last_button_serial, (void *)od->host_source, (void *)icon_surface);
+	fflush(stderr);
+
+	wl_data_device_start_drag(seat->wl_data_device, od->host_source,
+		output->surface, icon_surface, seat->last_button_serial);
+	wl_display_flush(wl->remote_display);
+}
+
+static void handle_pending_drag_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_wl_backend *wl = wl_container_of(listener, wl, pending_drag_destroy);
+	fprintf(stderr, "[sc7-dnd] pending drag destroyed cleanly while still inside rack\n");
+	fflush(stderr);
+	wl_list_remove(&wl->pending_drag_destroy.link);
+	wl->pending_outgoing_drag = NULL;
+}
+
+void wlr_wl_backend_set_pending_drag(struct wlr_wl_backend *wl, struct wlr_drag *drag) {
+	if (!wl) return;
+	if (wl->pending_outgoing_drag != NULL) {
+		wl_list_remove(&wl->pending_drag_destroy.link);
+		wl->pending_outgoing_drag = NULL;
+	}
+	if (!drag) return;
+
+	wl->pending_outgoing_drag = drag;
+	wl->pending_drag_destroy.notify = handle_pending_drag_destroy;
+	wl_signal_add(&drag->events.destroy, &wl->pending_drag_destroy);
+
+	fprintf(stderr, "[sc7-dnd] set pending outgoing drag=%p (internal until pointer leaves rack)\n",
+		(void *)drag);
+	fflush(stderr);
+}
+
+void wlr_wl_backend_promote_pending_drag(struct wlr_wl_backend *wl) {
+	if (!wl || !wl->pending_outgoing_drag) return;
+	struct wlr_drag *drag = wl->pending_outgoing_drag;
+	wl_list_remove(&wl->pending_drag_destroy.link);
+	wl->pending_outgoing_drag = NULL;
+
+	fprintf(stderr, "[sc7-dnd] promoting pending drag %p to host compositor!\n", (void *)drag);
+	fflush(stderr);
+
+	wlr_wl_backend_start_parent_drag(wl, drag);
+	wlr_drag_set_focus(drag, NULL, 0, 0);
+}

+
+/* --- Host Offer Listener --- */
+
+static void offer_handle_offer(void *data, struct wl_data_offer *offer, const char *mime_type) {
+	struct host_data_offer *ho = data;
+	if (!ho || !mime_type) return;
+
+	char **p;
+	wl_array_for_each(p, &ho->mimes) {
+		if (strcmp(*p, mime_type) == 0) return;
+	}
+	char **entry = wl_array_add(&ho->mimes, sizeof(char *));
+	if (entry) {
+		*entry = strdup(mime_type);
+	}
+}
+
+static void offer_handle_source_actions(void *data, struct wl_data_offer *offer, uint32_t source_actions) {
+	struct host_data_offer *ho = data;
+	if (ho) ho->source_actions = source_actions;
+}
+
+static void offer_handle_action(void *data, struct wl_data_offer *offer, uint32_t dnd_action) {
+	struct host_data_offer *ho = data;
+	if (ho) ho->dnd_action = dnd_action;
+}
+
+static const struct wl_data_offer_listener offer_listener = {
+	.offer = offer_handle_offer,
+	.source_actions = offer_handle_source_actions,
+	.action = offer_handle_action,
+};
+
+static void host_data_offer_destroy(struct host_data_offer *ho) {
+	if (!ho) return;
+	if (ho->proxy) {
+		ho->proxy->host_offer = NULL;
+	}
+	if (ho->backend->incoming_offer == ho) {
+		ho->backend->incoming_offer = NULL;
+	}
+	if (ho->backend->outgoing_drag && ho->backend->outgoing_drag->self_offer == ho) {
+		ho->backend->outgoing_drag->self_offer = NULL;
+	}
+	wl_list_remove(&ho->link);
+	if (ho->offer) {
+		wl_data_offer_destroy(ho->offer);
+	}
+	char **p;
+	wl_array_for_each(p, &ho->mimes) {
+		free(*p);
+	}
+	wl_array_release(&ho->mimes);
+	free(ho);
+}
+
+static struct host_data_offer *find_host_data_offer(struct wlr_wl_backend *backend,
+		struct wl_data_offer *offer) {
+	struct host_data_offer *ho;
+	wl_list_for_each(ho, &backend->dnd_offers, link) {
+		if (ho->offer == offer) {
+			return ho;
+		}
+	}
+	return NULL;
+}
+
+/* --- Proxy Data Source (Host -> Nested) --- */
+
+static void proxy_source_send(struct wlr_data_source *source, const char *mime_type, int32_t fd) {
+	struct proxy_data_source *p = (struct proxy_data_source *)source;
+	if (p && p->host_offer && p->host_offer->offer) {
+		wlr_log(WLR_INFO, "[sc7-dnd] proxying drop receive request for '%s' to host", mime_type);
+		wl_data_offer_receive(p->host_offer->offer, mime_type, fd);
+		while (wl_display_flush(p->backend->remote_display) == -1 && errno == EAGAIN) {
+			struct pollfd pfd = { .fd = wl_display_get_fd(p->backend->remote_display), .events = POLLOUT };
+			poll(&pfd, 1, 100);
+		}
+	}
+	close(fd);
+}
+
+static void proxy_source_accept(struct wlr_data_source *source, uint32_t serial, const char *mime_type) {
+	struct proxy_data_source *p = (struct proxy_data_source *)source;
+	if (p && p->host_offer && p->host_offer->offer) {
+		wl_data_offer_accept(p->host_offer->offer, serial, mime_type);
+		wl_display_flush(p->backend->remote_display);
+	}
+}
+
+static void proxy_source_dnd_finish(struct wlr_data_source *source) {
+	struct proxy_data_source *p = (struct proxy_data_source *)source;
+	if (p && p->host_offer && p->host_offer->offer) {
+		if (wl_data_offer_get_version(p->host_offer->offer) >= WL_DATA_OFFER_FINISH_SINCE_VERSION) {
+			wl_data_offer_finish(p->host_offer->offer);
+			wl_display_flush(p->backend->remote_display);
+		}
+		host_data_offer_destroy(p->host_offer);
+	}
+}
+
+static void proxy_source_dnd_action(struct wlr_data_source *source, enum wl_data_device_manager_dnd_action action) {
+	struct proxy_data_source *p = (struct proxy_data_source *)source;
+	if (p && p->host_offer && p->host_offer->offer) {
+		if (wl_data_offer_get_version(p->host_offer->offer) >= WL_DATA_OFFER_SET_ACTIONS_SINCE_VERSION) {
+			wl_data_offer_set_actions(p->host_offer->offer, action, action);
+			wl_display_flush(p->backend->remote_display);
+		}
+	}
+}
+
+static void proxy_source_destroy(struct wlr_data_source *source) {
+	struct proxy_data_source *p = (struct proxy_data_source *)source;
+	host_data_offer_destroy(p->host_offer);
+	free(p);
+}
+
+static const struct wlr_data_source_impl proxy_source_impl = {
+	.send = proxy_source_send,
+	.accept = proxy_source_accept,
+	.destroy = proxy_source_destroy,
+	.dnd_finish = proxy_source_dnd_finish,
+	.dnd_action = proxy_source_dnd_action,
+};
+
+/* --- Real Source Drag Icon Mirroring & Forwarding Helper --- */
+
+static void set_host_icon_visible(struct wlr_wl_outgoing_drag *od, bool visible) {
+	if (!od || !od->host_icon_surface) return;
+	if (od->host_icon_visible == visible) return;
+
+	od->host_icon_visible = visible;
+	if (visible) {
+		if (od->host_icon_buffer) {
+			if (wl_surface_get_version(od->host_icon_surface) >= WL_SURFACE_SET_BUFFER_SCALE_SINCE_VERSION) {
+				int32_t scale = od->icon_scale > 0 ? od->icon_scale : 1;
+				wl_surface_set_buffer_scale(od->host_icon_surface, scale);
+			}
+			if (wl_surface_get_version(od->host_icon_surface) >= WL_SURFACE_SET_BUFFER_TRANSFORM_SINCE_VERSION) {
+				wl_surface_set_buffer_transform(od->host_icon_surface, od->icon_transform);
+			}
+			if (wl_surface_get_version(od->host_icon_surface) >= WL_SURFACE_OFFSET_SINCE_VERSION) {
+				if (od->icon_dx != 0 || od->icon_dy != 0) {
+					wl_surface_offset(od->host_icon_surface, od->icon_dx, od->icon_dy);
+				}
+				wl_surface_attach(od->host_icon_surface, od->host_icon_buffer, 0, 0);
+			} else {
+				wl_surface_attach(od->host_icon_surface, od->host_icon_buffer, od->icon_dx, od->icon_dy);
+			}
+			if (wl_surface_get_version(od->host_icon_surface) >= WL_SURFACE_DAMAGE_BUFFER_SINCE_VERSION) {
+				wl_surface_damage_buffer(od->host_icon_surface, 0, 0, od->icon_width, od->icon_height);
+			} else {
+				wl_surface_damage(od->host_icon_surface, 0, 0, od->icon_width, od->icon_height);
+			}
+			wl_surface_commit(od->host_icon_surface);
+			wl_display_flush(od->backend->remote_display);
+			fprintf(stderr, "[sc7-dnd] host drag icon SHOWN outside SC7 Rack (%dx%d, scale=%d)\n",
+				od->icon_width, od->icon_height, od->icon_scale);
+			fflush(stderr);
+		}
+	} else {
+		wl_surface_attach(od->host_icon_surface, NULL, 0, 0);
+		wl_surface_commit(od->host_icon_surface);
+		wl_display_flush(od->backend->remote_display);
+		fprintf(stderr, "[sc7-dnd] host drag icon HIDDEN inside SC7 Rack\n");
+		fflush(stderr);
+	}
+}
+
+static void cleanup_outgoing_drag_icon(struct wlr_wl_outgoing_drag *od) {
+	if (!od) return;
+	od->host_icon_visible = false;
+	if (od->host_icon_surface) {
+		wl_surface_destroy(od->host_icon_surface);
+		od->host_icon_surface = NULL;
+	}
+	if (od->host_icon_buffer) {
+		wl_buffer_destroy(od->host_icon_buffer);
+		od->host_icon_buffer = NULL;
+	}
+	if (od->host_icon_pool) {
+		wl_shm_pool_destroy(od->host_icon_pool);
+		od->host_icon_pool = NULL;
+	}
+	if (od->icon_mmap && od->icon_size > 0) {
+		munmap(od->icon_mmap, od->icon_size);
+		od->icon_mmap = NULL;
+		od->icon_size = 0;
+	}
+	if (od->icon_fd >= 0) {
+		close(od->icon_fd);
+		od->icon_fd = -1;
+	}
+	od->icon_width = 0;
+	od->icon_height = 0;
+	od->icon_stride = 0;
+	if (od->backend && od->backend->remote_display) {
+		wl_display_flush(od->backend->remote_display);
+	}
+}
+
+static void mirror_wlr_surface_to_host(struct wlr_wl_outgoing_drag *od, struct wlr_surface *surface) {
+	if (!od || !od->host_icon_surface || !surface) {
+		return;
+	}
+
+	struct wlr_client_buffer *client_buffer = surface->buffer;
+	if (client_buffer == NULL) {
+		fprintf(stderr, "[sc7-dnd] mirror icon: surface has no buffer yet\n");
+		fflush(stderr);
+		return;
+	}
+
+	struct wlr_buffer *src_buffer = client_buffer->source ? client_buffer->source : &client_buffer->base;
+	int width = src_buffer->width;
+	int height = src_buffer->height;
+	if (width <= 0 || height <= 0) {
+		return;
+	}
+
+	void *src_data = NULL;
+	uint32_t src_format = 0;
+	size_t src_stride = 0;
+	void *renderer_pixels = NULL;
+	bool ok_read = false;
+
+	if (wlr_buffer_begin_data_ptr_access(src_buffer,
+			WLR_BUFFER_DATA_PTR_ACCESS_READ, &src_data, &src_format, &src_stride)) {
+		ok_read = true;
+	} else if (surface->renderer != NULL) {
+		size_t temp_size = (size_t)width * height * 4;
+		renderer_pixels = malloc(temp_size);
+		if (renderer_pixels) {
+			if (renderer_bind_buffer(surface->renderer, src_buffer)) {
+				if (wlr_renderer_read_pixels(surface->renderer, DRM_FORMAT_ARGB8888,
+						width * 4, width, height, 0, 0, 0, 0, renderer_pixels)) {
+					src_data = renderer_pixels;
+					src_format = DRM_FORMAT_ARGB8888;
+					src_stride = width * 4;
+					ok_read = true;
+				}
+				renderer_bind_buffer(surface->renderer, NULL);
+			}
+			if (!ok_read) {
+				free(renderer_pixels);
+				renderer_pixels = NULL;
+			}
+		}
+	}
+
+	if (!ok_read || !src_data) {
+		fprintf(stderr, "[sc7-dnd] mirror icon: cannot read pixels from surface buffer %p (%dx%d)\n",
+			(void *)src_buffer, width, height);
+		fflush(stderr);
+		return;
+	}
+
+	int dst_stride = width * 4;
+	size_t size = (size_t)dst_stride * height;
+
+	if (od->icon_mmap == NULL || od->icon_width != width || od->icon_height != height) {
+		if (od->host_icon_buffer) {
+			wl_buffer_destroy(od->host_icon_buffer);
+			od->host_icon_buffer = NULL;
+		}
+		if (od->host_icon_pool) {
+			wl_shm_pool_destroy(od->host_icon_pool);
+			od->host_icon_pool = NULL;
+		}
+		if (od->icon_mmap && od->icon_size > 0) {
+			munmap(od->icon_mmap, od->icon_size);
+			od->icon_mmap = NULL;
+			od->icon_size = 0;
+		}
+		if (od->icon_fd >= 0) {
+			close(od->icon_fd);
+			od->icon_fd = -1;
+		}
+
+		od->icon_fd = memfd_create("sc7-drag-icon-mirror", MFD_CLOEXEC);
+		if (od->icon_fd < 0) {
+			if (renderer_pixels) free(renderer_pixels);
+			else wlr_buffer_end_data_ptr_access(src_buffer);
+			return;
+		}
+		if (ftruncate(od->icon_fd, size) < 0) {
+			close(od->icon_fd);
+			od->icon_fd = -1;
+			if (renderer_pixels) free(renderer_pixels);
+			else wlr_buffer_end_data_ptr_access(src_buffer);
+			return;
+		}
+
+		od->icon_mmap = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, od->icon_fd, 0);
+		if (od->icon_mmap == MAP_FAILED) {
+			od->icon_mmap = NULL;
+			close(od->icon_fd);
+			od->icon_fd = -1;
+			if (renderer_pixels) free(renderer_pixels);
+			else wlr_buffer_end_data_ptr_access(src_buffer);
+			return;
+		}
+
+		od->icon_width = width;
+		od->icon_height = height;
+		od->icon_stride = dst_stride;
+		od->icon_size = size;
+
+		od->host_icon_pool = wl_shm_create_pool(od->backend->shm, od->icon_fd, size);
+		od->host_icon_buffer = wl_shm_pool_create_buffer(od->host_icon_pool, 0, width, height, dst_stride, WL_SHM_FORMAT_ARGB8888);
+	}
+
+	size_t copy_bytes = (size_t)width * 4;
+	if (copy_bytes > src_stride) copy_bytes = src_stride;
+	for (int y = 0; y < height; y++) {
+		memcpy((char *)od->icon_mmap + y * dst_stride, (const char *)src_data + y * src_stride, copy_bytes);
+	}
+
+	if (renderer_pixels) {
+		free(renderer_pixels);
+	} else {
+		wlr_buffer_end_data_ptr_access(src_buffer);
+	}
+
+	od->icon_scale = surface->current.scale > 0 ? surface->current.scale : 1;
+	od->icon_transform = surface->current.transform;
+	od->icon_dx = surface->current.dx;
+	od->icon_dy = surface->current.dy;
+
+	if (od->host_icon_visible) {
+		if (wl_surface_get_version(od->host_icon_surface) >= WL_SURFACE_SET_BUFFER_SCALE_SINCE_VERSION) {
+			wl_surface_set_buffer_scale(od->host_icon_surface, od->icon_scale);
+		}
+		if (wl_surface_get_version(od->host_icon_surface) >= WL_SURFACE_SET_BUFFER_TRANSFORM_SINCE_VERSION) {
+			wl_surface_set_buffer_transform(od->host_icon_surface, od->icon_transform);
+		}
+		if (wl_surface_get_version(od->host_icon_surface) >= WL_SURFACE_OFFSET_SINCE_VERSION) {
+			if (od->icon_dx != 0 || od->icon_dy != 0) {
+				wl_surface_offset(od->host_icon_surface, od->icon_dx, od->icon_dy);
+			}
+			wl_surface_attach(od->host_icon_surface, od->host_icon_buffer, 0, 0);
+		} else {
+			wl_surface_attach(od->host_icon_surface, od->host_icon_buffer, od->icon_dx, od->icon_dy);
+		}
+		if (wl_surface_get_version(od->host_icon_surface) >= WL_SURFACE_DAMAGE_BUFFER_SINCE_VERSION) {
+			wl_surface_damage_buffer(od->host_icon_surface, 0, 0, width, height);
+		} else {
+			wl_surface_damage(od->host_icon_surface, 0, 0, surface->current.width, surface->current.height);
+		}
+
+		wl_surface_commit(od->host_icon_surface);
+		wl_display_flush(od->backend->remote_display);
+
+		fprintf(stderr, "[sc7-dnd] updated visible host drag icon (%dx%d, scale=%d, offset=%d,%d)\n",
+			width, height, od->icon_scale, od->icon_dx, od->icon_dy);
+		fflush(stderr);
+	} else {
+		fprintf(stderr, "[sc7-dnd] buffered host drag icon in memory (%dx%d, scale=%d, hidden inside rack)\n",
+			width, height, od->icon_scale);
+		fflush(stderr);
+	}
+}
+
+static void handle_drag_icon_commit(struct wl_listener *listener, void *data) {
+	struct wlr_wl_outgoing_drag *od = wl_container_of(listener, od, icon_commit);
+	if (od && od->wlr_icon && od->wlr_icon->surface) {
+		mirror_wlr_surface_to_host(od, od->wlr_icon->surface);
+	}
+}
+
+static void handle_drag_icon_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_wl_outgoing_drag *od = wl_container_of(listener, od, icon_destroy);
+	if (od) {
+		fprintf(stderr, "[sc7-dnd] nested drag icon destroyed\n");
+		fflush(stderr);
+		wl_list_remove(&od->icon_commit.link);
+		wl_list_remove(&od->icon_destroy.link);
+		od->wlr_icon = NULL;
+		cleanup_outgoing_drag_icon(od);
+	}
+}
+
+struct send_forward_ctx {
+	int src_fd;
+	int dst_fd;
+	char *mime;
+};
+
+static void *send_forward_worker(void *arg) {
+	struct send_forward_ctx *ctx = arg;
+	char buf[4096];
+	ssize_t n;
+	bool logged = false;
+	size_t total = 0;
+	int io_error = 0;
+	sigset_t sigpipe_set, old_mask;
+	sigemptyset(&sigpipe_set);
+	sigaddset(&sigpipe_set, SIGPIPE);
+	io_error = pthread_sigmask(SIG_BLOCK, &sigpipe_set, &old_mask);
+	if (io_error != 0) goto done;
+
+	while (true) {
+		n = read(ctx->src_fd, buf, sizeof(buf));
+		if (n < 0 && errno == EINTR) continue;
+		if (n < 0) {
+			io_error = errno;
+			break;
+		}
+		if (n == 0) break;
+		if (!logged) {
+			fprintf(stderr, "[sc7-dnd] send '%s': first chunk %zd bytes\n",
+				ctx->mime, n);
+			fflush(stderr);
+			logged = true;
+		}
+		ssize_t written = 0;
+		while (written < n) {
+			ssize_t w = write(ctx->dst_fd, buf + written, n - written);
+			if (w < 0 && errno == EINTR) continue;
+			if (w <= 0) {
+				io_error = w < 0 ? errno : EIO;
+				break;
+			}
+			written += w;
+			total += w;
+		}
+		if (io_error != 0) break;
+	}
+	if (io_error == EPIPE) {
+		// Consume the SIGPIPE generated by write before restoring the mask.
+		struct timespec timeout = {0};
+		sigtimedwait(&sigpipe_set, NULL, &timeout);
+	}
+	pthread_sigmask(SIG_SETMASK, &old_mask, NULL);
+
+done:
+	if (io_error != 0) {
+		fprintf(stderr, "[sc7-dnd] send '%s': stopped after %zu bytes: %s\n",
+			ctx->mime, total, strerror(io_error));
+		fflush(stderr);
+	} else if (!logged) {
+		fprintf(stderr, "[sc7-dnd] send '%s': 0 bytes transferred (EOF/closed)\n", ctx->mime);
+		fflush(stderr);
+	} else {
+		fprintf(stderr, "[sc7-dnd] send '%s': total %zu bytes transferred successfully\n", ctx->mime, total);
+		fflush(stderr);
+	}
+	close(ctx->src_fd);
+	close(ctx->dst_fd);
+	free(ctx->mime);
+	free(ctx);
+	return NULL;
+}
+
+/* --- Outgoing Source Listener (Nested -> Host) --- */
+
+static void outgoing_source_handle_target(void *data, struct wl_data_source *source, const char *mime_type) {
+	fprintf(stderr, "[sc7-dnd] outgoing target: %s\n", mime_type ? mime_type : "(null)");
+	fflush(stderr);
+	struct wlr_wl_outgoing_drag *od = data;
+	if (od && od->wlr_drag && od->wlr_drag->source) {
+		wlr_data_source_accept(od->wlr_drag->source, 0, mime_type);
+	}
+}
+
+static void outgoing_source_handle_send(void *data, struct wl_data_source *source, const char *mime_type, int32_t fd) {
+	fprintf(stderr, "[sc7-dnd] outgoing send requested: %s (host fd=%d)\n", mime_type ? mime_type : "(null)", fd);
+	fflush(stderr);
+	struct wlr_wl_outgoing_drag *od = data;
+	if (!od || !od->wlr_drag || !od->wlr_drag->source) {
+		close(fd);
+		return;
+	}
+
+	int p[2];
+	if (pipe2(p, O_CLOEXEC) < 0) {
+		wlr_data_source_send(od->wlr_drag->source, mime_type, fd);
+		return;
+	}
+
+	struct send_forward_ctx *ctx = calloc(1, sizeof(*ctx));
+	if (!ctx) {
+		close(p[0]);
+		close(p[1]);
+		wlr_data_source_send(od->wlr_drag->source, mime_type, fd);
+		return;
+	}
+
+	ctx->src_fd = p[0];
+	ctx->dst_fd = fd;
+	ctx->mime = strdup(mime_type ? mime_type : "unknown");
+
+	pthread_t th;
+	if (pthread_create(&th, NULL, send_forward_worker, ctx) != 0) {
+		close(p[0]);
+		close(p[1]);
+		free(ctx->mime);
+		free(ctx);
+		wlr_data_source_send(od->wlr_drag->source, mime_type, fd);
+		return;
+	}
+	pthread_detach(th);
+
+	wlr_data_source_send(od->wlr_drag->source, mime_type, p[1]);
+}
+
+static void outgoing_source_handle_cancelled(void *data, struct wl_data_source *source) {
+	fprintf(stderr, "[sc7-dnd] host CANCELLED outgoing drag!\n");
+	fflush(stderr);
+	struct wlr_wl_outgoing_drag *od = data;
+	if (od) {
+		host_data_offer_destroy(od->self_offer);
+		if (od->wlr_icon) {
+			wl_list_remove(&od->icon_commit.link);
+			wl_list_remove(&od->icon_destroy.link);
+			od->wlr_icon = NULL;
+		}
+		cleanup_outgoing_drag_icon(od);
+		if (od->backend && od->backend->outgoing_drag == od) {
+			od->backend->outgoing_drag = NULL;
+		}
+		if (od->wlr_drag) {
+			wl_list_remove(&od->drag_destroy.link);
+			wlr_drag_destroy(od->wlr_drag);
+			od->wlr_drag = NULL;
+		}
+		wlr_wl_pointer_release_button(od->seat, od->button,
+			(uint32_t)get_current_time_msec());
+		wl_data_source_destroy(source);
+		free(od);
+	}
+}
+
+static void outgoing_source_handle_dnd_drop_performed(void *data, struct wl_data_source *source) {
+	fprintf(stderr, "[sc7-dnd] host outgoing DROP PERFORMED!\n");
+	fflush(stderr);
+	struct wlr_wl_outgoing_drag *od = data;
+	if (od && od->wlr_drag && od->wlr_drag->source) {
+		wlr_data_source_dnd_drop(od->wlr_drag->source);
+	}
+}
+
+static void outgoing_source_handle_dnd_finished(void *data, struct wl_data_source *source) {
+	fprintf(stderr, "[sc7-dnd] host outgoing DND FINISHED!\n");
+	fflush(stderr);
+	struct wlr_wl_outgoing_drag *od = data;
+	if (od) {
+		host_data_offer_destroy(od->self_offer);
+		if (od->wlr_icon) {
+			wl_list_remove(&od->icon_commit.link);
+			wl_list_remove(&od->icon_destroy.link);
+			od->wlr_icon = NULL;
+		}
+		cleanup_outgoing_drag_icon(od);
+		if (od->backend && od->backend->outgoing_drag == od) {
+			od->backend->outgoing_drag = NULL;
+		}
+		if (od->wlr_drag) {
+			wl_list_remove(&od->drag_destroy.link);
+			if (od->wlr_drag->source) {
+				wlr_data_source_dnd_finish(od->wlr_drag->source);
+			}
+			wlr_drag_destroy(od->wlr_drag);
+			od->wlr_drag = NULL;
+		}
+		wlr_wl_pointer_release_button(od->seat, od->button,
+			(uint32_t)get_current_time_msec());
+		wl_data_source_destroy(source);
+		free(od);
+	}
+}
+
+static void outgoing_source_handle_action(void *data, struct wl_data_source *source, uint32_t dnd_action) {
+	fprintf(stderr, "[sc7-dnd] host outgoing action: %u\n", dnd_action);
+	fflush(stderr);
+	struct wlr_wl_outgoing_drag *od = data;
+	if (od && od->wlr_drag && od->wlr_drag->source) {
+		wlr_data_source_dnd_action(od->wlr_drag->source, dnd_action);
+	}
+}

+static void handle_outgoing_drag_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_wl_outgoing_drag *od = wl_container_of(listener, od, drag_destroy);
+	if (od) {
+		host_data_offer_destroy(od->self_offer);
+		if (od->wlr_icon) {
+			wl_list_remove(&od->icon_commit.link);
+			wl_list_remove(&od->icon_destroy.link);
+			od->wlr_icon = NULL;
+		}
+		cleanup_outgoing_drag_icon(od);
+		wl_list_remove(&od->drag_destroy.link);
+		od->wlr_drag = NULL;
+		if (od->backend && od->backend->outgoing_drag == od) {
+			od->backend->outgoing_drag = NULL;
+		}
+		if (od->host_source) {
+			wl_data_source_destroy(od->host_source);
+			od->host_source = NULL;
+		}
+		wlr_wl_pointer_release_button(od->seat, od->button,
+			(uint32_t)get_current_time_msec());
+		free(od);
+	}
+}

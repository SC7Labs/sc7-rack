+static const struct wl_data_source_listener outgoing_source_listener = {
+	.target = outgoing_source_handle_target,
+	.send = outgoing_source_handle_send,
+	.cancelled = outgoing_source_handle_cancelled,
+	.dnd_drop_performed = outgoing_source_handle_dnd_drop_performed,
+	.dnd_finished = outgoing_source_handle_dnd_finished,
+	.action = outgoing_source_handle_action,
+};

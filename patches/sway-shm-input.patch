+// Rack v0.1 uses SHM for nested client inputs. Keep GLES2 rendering and the
+// output allocator unchanged; hide both client DMA-BUF factories, including
+// explicit registry binds. The remaining Sway security policy still applies.
+static bool rack_client_buffer_protocol_allowed(const struct wl_global *global) {
+	const char *interface = wl_global_get_interface(global)->name;
+	return strcmp(interface, "zwp_linux_dmabuf_v1") != 0 &&
+		strcmp(interface, "wl_drm") != 0;
+}

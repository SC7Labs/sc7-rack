#!/usr/bin/env bash
set -euo pipefail

# Capture the host session before preparing Rack's nested compositor.
export SC7_HOST_PATH="${PATH:-/usr/local/bin:/usr/bin:/bin}"
for var in DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS SWAYSOCK I3SOCK \
           LD_LIBRARY_PATH WLR_BACKENDS WLR_LIBINPUT_NO_DEVICES \
           WLR_EGL_NO_MODIFIERS; do
    value_name="SC7_HOST_$var"
    set_name="${value_name}_SET"
    printf -v "$value_name" '%s' "${!var-}"
    printf -v "$set_name" '%s' "${!var+x}"
    export "$value_name" "$set_name"
done

# Ensure essential paths in environment
XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"
export PATH="$XDG_BIN_HOME:$HOME/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
FULL_REPAINT="${SC7_RACK_FULL_REPAINT:-0}"
if [[ "$FULL_REPAINT" != 0 && "$FULL_REPAINT" != 1 ]]; then
    echo "Error: SC7_RACK_FULL_REPAINT must be 0 or 1" >&2
    exit 2
fi

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}"
RACK_RUN_DIR="$RUNTIME_DIR/sc7-rack"
mkdir -p "$RACK_RUN_DIR"
PID_FILE="$RACK_RUN_DIR/sc7-rack.pid"
INNER_PIDS_FILE="$RACK_RUN_DIR/inner_pids"
INNER_HELPER_PID_FILE="$RACK_RUN_DIR/inner_helper.pid"

# Resolve real path of this script to find the repository root even via symlinks
REAL_BIN="$(readlink -f "$0")"
PROJECT_ROOT="$(dirname "$(dirname "$REAL_BIN")")"

get_running_rack_pid() {
    local pid=""
    if [[ -f "$PID_FILE" ]]; then
        pid="$(cat "$PID_FILE" 2>/dev/null || true)"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            if grep -q "sway" "/proc/$pid/cmdline" 2>/dev/null; then
                for sock in "$RUNTIME_DIR"/sway-ipc.*."$pid".sock; do
                    if [[ -S "$sock" ]] && SWAYSOCK="$sock" swaymsg -t get_version >/dev/null 2>&1; then
                        num_outputs="$(SWAYSOCK="$sock" swaymsg -t get_outputs 2>/dev/null | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo "1")"
                        if [[ "$num_outputs" -gt 0 ]]; then
                            echo "$pid"
                            return 0
                        else
                            kill -TERM "$pid" 2>/dev/null || true
                            sleep 0.1
                            kill -KILL "$pid" 2>/dev/null || true
                        fi
                    fi
                done
            fi
        fi
        rm -f "$PID_FILE"
    fi

    # Fallback: check any active sway process running sc7-rack config
    for cpid in $(pgrep -f '[s]way.*sc7-rack/config' 2>/dev/null || true); do
        if [[ -n "$cpid" ]] && kill -0 "$cpid" 2>/dev/null; then
            if grep -q "sway" "/proc/$cpid/cmdline" 2>/dev/null; then
                for sock in "$RUNTIME_DIR"/sway-ipc.*."$cpid".sock; do
                    if [[ -S "$sock" ]] && SWAYSOCK="$sock" swaymsg -t get_version >/dev/null 2>&1; then
                        num_outputs="$(SWAYSOCK="$sock" swaymsg -t get_outputs 2>/dev/null | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo "1")"
                        if [[ "$num_outputs" -gt 0 ]]; then
                            echo "$cpid" > "$PID_FILE"
                            echo "$cpid"
                            return 0
                        else
                            kill -TERM "$cpid" 2>/dev/null || true
                            sleep 0.1
                            kill -KILL "$cpid" 2>/dev/null || true
                        fi
                    fi
                done
            fi
        fi
    done

    return 1
}

stop_inner_helper() {
    local helper_pid="" helper_start="" actual_start=""
    [[ -f "$INNER_HELPER_PID_FILE" ]] || return 0
    read -r helper_pid helper_start < "$INNER_HELPER_PID_FILE" || true
    if [[ "$helper_pid" =~ ^[0-9]+$ && "$helper_start" =~ ^[0-9]+$ ]]; then
        actual_start="$(awk '{print $22}' "/proc/$helper_pid/stat" 2>/dev/null || true)"
        if [[ "$actual_start" == "$helper_start" ]]; then
            kill -TERM "$helper_pid" 2>/dev/null || true
        fi
    fi
    rm -f "$INNER_HELPER_PID_FILE"
}

# Handle command line flags
if [[ "${1:-}" == "--status" ]]; then
    if RUNNING_PID="$(get_running_rack_pid)"; then
        echo "SC7Labs Rack is running (PID $RUNNING_PID)"
        exit 0
    else
        echo "SC7Labs Rack is not running"
        exit 1
    fi
elif [[ "${1:-}" == "--stop" ]]; then
    if RUNNING_PID="$(get_running_rack_pid)"; then
        echo "Stopping SC7Labs Rack (PID $RUNNING_PID)..."
        kill -TERM "$RUNNING_PID" 2>/dev/null || true
        for ((i=0; i<30; i++)); do
            if ! kill -0 "$RUNNING_PID" 2>/dev/null; then
                break
            fi
            sleep 0.1
        done
        if kill -0 "$RUNNING_PID" 2>/dev/null; then
            kill -KILL "$RUNNING_PID" 2>/dev/null || true
        fi
        stop_inner_helper
        # Terminate any tracked inner clients
        if [[ -f "$INNER_PIDS_FILE" ]]; then
            while IFS= read -r cpid; do
                if [[ -n "$cpid" ]] && kill -0 "$cpid" 2>/dev/null; then
                    kill -TERM "$cpid" 2>/dev/null || true
                fi
            done < "$INNER_PIDS_FILE"
            rm -f "$INNER_PIDS_FILE"
        fi
        rm -f "$PID_FILE"
        echo "SC7Labs Rack stopped."
    else
        echo "SC7Labs Rack is not running."
    fi
    exit 0
elif [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: sc7-rack [--status | --stop | --help]"
    echo "  (no args) Launch SC7Labs Rack workspace"
    echo "  --status  Check if SC7Labs Rack is currently active"
    echo "  --stop    Cleanly stop running SC7Labs Rack instances"
    exit 0
fi

# Check if already running
if RUNNING_PID="$(get_running_rack_pid)"; then
    echo "SC7Labs Rack is already running (PID $RUNNING_PID)."
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "SC7Labs Rack" "SC7Labs Rack is already running on your desktop." --icon=sc7-rack 2>/dev/null || true
    fi
    exit 0
fi

# Ensure host Wayland display is discovered dynamically and preserved
if ! command -v fuser >/dev/null 2>&1; then
    echo "Error: fuser is unavailable. Run ./install.sh to install the psmisc dependency." >&2
    exit 1
fi
HOST_DISP="${WAYLAND_DISPLAY:-${SC7_HOST_WAYLAND_DISPLAY:-}}"
if [[ -z "$HOST_DISP" ]]; then
    for lockfile in "$RUNTIME_DIR"/wayland-[0-9]*.lock; do
        if [[ -f "$lockfile" ]] && fuser "$lockfile" >/dev/null 2>&1; then
            HOST_DISP="$(basename "${lockfile%.lock}")"
            break
        fi
    done
fi
if [[ -z "$HOST_DISP" ]]; then
    echo "Error: could not find the host Wayland display." >&2
    exit 1
fi
export SC7_HOST_WAYLAND_DISPLAY="$HOST_DISP"
export WAYLAND_DISPLAY="$HOST_DISP"

# Resolve the host opener before the nested session receives its private shim.
HOST_XDG_OPEN="$(type -P xdg-open || true)"
if [[ -z "$HOST_XDG_OPEN" || ! -x "$HOST_XDG_OPEN" ]]; then
    echo "Error: host xdg-open is unavailable." >&2
    exit 1
fi
export SC7_HOST_XDG_OPEN="$(readlink -f -- "$HOST_XDG_OPEN")"
export SC7_RACK_PRIVATE_BIN="$PROJECT_ROOT/bin/rack-private"
if [[ ! -x "$SC7_RACK_PRIVATE_BIN/xdg-open" || ! -x "$PROJECT_ROOT/bin/sc7-rack-open-host" ||
      ! -x "$PROJECT_ROOT/bin/sc7-rack-files" ]]; then
    echo "Error: Rack host-open bridge is missing or not executable." >&2
    exit 1
fi

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-COSMIC}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export SC7_APP_ID="dev.sc7labs.rack"
export SC7_APP_TITLE="SC7Labs Rack"

# Clean up stale non-host wayland sockets/locks if previous session terminated abnormally
shopt -s nullglob
for lockfile in "$RUNTIME_DIR"/wayland-[0-9]*.lock; do
    if [[ -f "$lockfile" ]] && ! fuser "$lockfile" >/dev/null 2>&1; then
        sock="${lockfile%.lock}"
        if [[ "$(basename "$sock")" != "$HOST_DISP" ]]; then
            rm -f "$sock" "$lockfile"
        fi
    fi
done
shopt -u nullglob

# Prepend custom wlroots library build path
WLROOTS_BUILD="$PROJECT_ROOT/vendor/wlroots/build"
if [[ -d "$WLROOTS_BUILD" && -f "$WLROOTS_BUILD/libwlroots.so.12" ]]; then
    export LD_LIBRARY_PATH="$WLROOTS_BUILD${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# Use Wayland backend for nested operation inside host compositor
export WLR_BACKENDS=wayland
export WLR_LIBINPUT_NO_DEVICES=1
# Avoid explicit DMA-BUF modifiers by default. This does not eliminate the
# nested GLES2 corruption seen on laptop2; Pixman is the known-good control.
export WLR_EGL_NO_MODIFIERS="${WLR_EGL_NO_MODIFIERS:-1}"

# Rack uses a pinned local Sway build. The explicit override is used by the
# isolated launcher tests; normal sessions verify the source and build stamp
# before starting, so an old system Sway cannot silently restore the popup bug.
SWAY_BIN="${SC7_RACK_SWAY_BINARY:-$PROJECT_ROOT/vendor/sway/build/sway/sway}"
if [[ -n "${SC7_RACK_SWAY_BINARY:-}" ]]; then
    if [[ ! -x "$SWAY_BIN" ]]; then
        echo "Error: Sway override is not executable: $SWAY_BIN" >&2
        exit 1
    fi
elif [[ ! -x "$PROJECT_ROOT/scripts/bootstrap-sway.sh" ]] ||
     ! "$PROJECT_ROOT/scripts/bootstrap-sway.sh" --check; then
    echo "Error: Rack-local Sway is missing or stale. Run ./install.sh." >&2
    exit 1
fi

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sc7-rack"
CONFIG_FILE="$CONFIG_DIR/config"
if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$CONFIG_DIR"
    cp "$PROJECT_ROOT/config/config" "$CONFIG_FILE"
elif grep -q -E 'window_role|window_type' "$CONFIG_FILE"; then
    # Obsolete X11/XWayland criteria cause config parser errors in Rack Sway (built without XWayland).
    sed -i -E '/for_window \[(window_role|window_type)=/d' "$CONFIG_FILE"
fi
# Keep the installed helper in step with the launcher. Otherwise an existing
# installation keeps polling a stale Sway socket after the source is updated.
if [[ ! -f "$CONFIG_DIR/inner.sh" ]] || ! cmp -s "$PROJECT_ROOT/config/inner.sh" "$CONFIG_DIR/inner.sh"; then
    cp "$PROJECT_ROOT/config/inner.sh" "$CONFIG_DIR/inner.sh"
    chmod +x "$CONFIG_DIR/inner.sh"
fi

# Prepare fresh inner_pids tracking file
> "$INNER_PIDS_FILE"
rm -f "$INNER_HELPER_PID_FILE"

cleanup() {
    trap - EXIT INT TERM HUP
    echo "Shutting down SC7 Rack..." >&2

    # 1. Stop a still-running layout pass belonging to this compositor.
    stop_inner_helper

    # 2. Terminate tracked inner client PIDs
    if [[ -f "$INNER_PIDS_FILE" ]]; then
        while IFS= read -r cpid; do
            if [[ -n "$cpid" ]] && kill -0 "$cpid" 2>/dev/null; then
                kill -TERM "$cpid" 2>/dev/null || true
            fi
        done < "$INNER_PIDS_FILE"
        sleep 0.1
        if [[ -f "$INNER_PIDS_FILE" ]]; then
            while IFS= read -r cpid; do
                if [[ -n "$cpid" ]] && kill -0 "$cpid" 2>/dev/null; then
                    kill -KILL "$cpid" 2>/dev/null || true
                fi
            done < "$INNER_PIDS_FILE"
            rm -f "$INNER_PIDS_FILE"
        fi
    fi

    # 3. Terminate this Rack compositor. Its inner helper and launched clients
    # were recorded above; avoid name/parent-pattern kills that can affect
    # another session.
    if [[ -n "${SWAY_PID:-}" ]] && kill -0 "$SWAY_PID" 2>/dev/null; then
        kill -TERM "$SWAY_PID" 2>/dev/null || true
        sleep 0.2
        if kill -0 "$SWAY_PID" 2>/dev/null; then
            kill -KILL "$SWAY_PID" 2>/dev/null || true
        fi
    fi

    # 4. Clean up PID file and socket
    rm -f "$PID_FILE"
    if [[ -n "${SWAY_PID:-}" ]]; then
        rm -f "$RUNTIME_DIR/sway-ipc."*"."$SWAY_PID".sock" 2>/dev/null || true
    fi
}

cd "$HOME"
SWAY_ARGS=(--config "$CONFIG_FILE")
if [[ "$FULL_REPAINT" == 1 ]]; then
    # Sway's built-in diagnostic renders every damaged frame in full and
    # reports full-output damage. Keep this opt-in until physical A/B data
    # distinguishes damage/buffer-age errors from texture import errors.
    SWAY_ARGS=(-D damage=rerender "${SWAY_ARGS[@]}")
    echo "Rack diagnostic: full-output repaint enabled" >&2
fi
if [[ -n "${SC7_RACK_RENDER_TRACE_LIB:-}" ]]; then
    if [[ ! -f "$SC7_RACK_RENDER_TRACE_LIB" || "$SC7_RACK_RENDER_TRACE_LIB" =~ [[:space:]] ]]; then
        echo "Error: Rack render tracer is missing or its path contains whitespace." >&2
        exit 2
    fi
    # Scope the diagnostic preload to this compositor. The tracer clears its
    # own LD_PRELOAD entry during library initialization before Sway starts apps.
    PATH="$SC7_RACK_PRIVATE_BIN:$PATH" LD_PRELOAD="$SC7_RACK_RENDER_TRACE_LIB" \
        "$SWAY_BIN" "${SWAY_ARGS[@]}" &
else
    PATH="$SC7_RACK_PRIVATE_BIN:$PATH" "$SWAY_BIN" "${SWAY_ARGS[@]}" &
fi
SWAY_PID=$!
echo "$SWAY_PID" > "$PID_FILE"

trap cleanup EXIT INT TERM HUP

SWAY_STATUS=0
wait "$SWAY_PID" 2>/dev/null || SWAY_STATUS=$?
cleanup
exit "$SWAY_STATUS"

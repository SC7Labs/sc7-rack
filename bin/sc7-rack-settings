#!/usr/bin/env python3
import json
import os
import sys
import subprocess
import signal
import shutil

try:
    import tkinter as tk
    from tkinter import ttk, filedialog, messagebox
    HAS_TKINTER = True
except ImportError:
    HAS_TKINTER = False
    # Attempt to locate an alternate system python that has tkinter installed
    _candidates = [
        shutil.which("python3"),
        shutil.which("python"),
        "/usr/local/bin/python3",
        "/usr/bin/python3",
    ]
    for _cand in _candidates:
        if _cand and os.path.exists(_cand) and _cand != sys.executable:
            try:
                _r = subprocess.run([_cand, "-c", "import tkinter"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if _r.returncode == 0:
                    os.execv(_cand, [_cand] + sys.argv)
            except Exception:
                pass

XDG_CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
CONFIG_DIR = os.path.join(XDG_CONFIG_HOME, "sc7-rack")
SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.json")
AUTOSTART_DIR = os.path.join(XDG_CONFIG_HOME, "autostart")
AUTOSTART_FILE = os.path.join(AUTOSTART_DIR, "sc7-rack.desktop")
REAL_PATH = os.path.realpath(__file__)
PROJECT_ROOT = os.path.dirname(os.path.dirname(REAL_PATH))
ICON_PATH = os.path.join(PROJECT_ROOT, "assets/icons/sc7-rack-128.png")
sys.path.insert(0, os.path.join(PROJECT_ROOT, "scripts"))
from install_launchers import desktop_exec

DEFAULT_SETTINGS = {
    "autostart": False,
    "share_clipboard": True,
    "files_path": os.path.expanduser("~"),
    "gpu_provider": "auto",
    "gpu_custom_command": ""
}

def load_settings():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(SETTINGS_FILE):
        return dict(DEFAULT_SETTINGS)
    try:
        with open(SETTINGS_FILE, "r") as f:
            data = json.load(f)
            settings = dict(DEFAULT_SETTINGS)
            settings.update(data)
            # If files_path is empty or invalid, default to $HOME
            if not settings.get("files_path"):
                settings["files_path"] = os.path.expanduser("~")
            return settings
    except Exception:
        return dict(DEFAULT_SETTINGS)

def save_settings(settings):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(SETTINGS_FILE, "w") as f:
        json.dump(settings, f, indent=2)
    sync_autostart(settings.get("autostart", False))
    sync_live_bridge(settings.get("share_clipboard", True))

def sync_autostart(enabled):
    os.makedirs(AUTOSTART_DIR, exist_ok=True)
    if enabled:
        exec_path = desktop_exec([os.path.join(PROJECT_ROOT, "bin", "sc7-rack")])
        content = (
            "[Desktop Entry]\n"
            "Type=Application\n"
            "Name=SC7Labs Rack\n"
            "GenericName=Developer Rack Compositor\n"
            "Comment=Nested 2x2 developer workspace with terminal, files, monitor, and htop\n"
            f"Exec={exec_path}\n"
            "Icon=sc7-rack\n"
            "Terminal=false\n"
            "Categories=COSMIC;System;Utility;Development;\n"
            "StartupWMClass=dev.sc7labs.rack\n"
        )
        with open(AUTOSTART_FILE, "w") as f:
            f.write(content)
    else:
        if os.path.exists(AUTOSTART_FILE):
            try:
                os.remove(AUTOSTART_FILE)
            except OSError:
                pass

def get_rack_status():
    rundir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    rack_rundir = os.path.join(rundir, "sc7-rack")
    pid_file = os.path.join(rack_rundir, "sc7-rack.pid")

    candidate_pids = []
    if os.path.exists(pid_file):
        try:
            with open(pid_file, "r") as f:
                p = int(f.read().strip())
                candidate_pids.append(p)
        except Exception:
            pass

    try:
        out = subprocess.check_output(["pgrep", "-f", "[s]way.*sc7-rack/config"], text=True)
        for line in out.strip().splitlines():
            if line.strip().isdigit():
                p = int(line.strip())
                if p not in candidate_pids:
                    candidate_pids.append(p)
    except Exception:
        pass

    for pid in candidate_pids:
        try:
            os.kill(pid, 0)
        except OSError:
            continue

        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read().decode("utf-8", errors="ignore")
                if "sway" not in cmd:
                    continue
        except Exception:
            continue

        # Check Sway IPC responsiveness
        try:
            for name in os.listdir(rundir):
                if name.startswith("sway-ipc.") and name.endswith(f".{pid}.sock"):
                    sock = os.path.join(rundir, name)
                    env = os.environ.copy()
                    env["SWAYSOCK"] = sock
                    res = subprocess.run(["swaymsg", "-t", "get_version"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    if res.returncode == 0:
                        return {"running": True, "pid": pid}
        except Exception:
            pass

    return {"running": False, "pid": None}

def get_bridge_status():
    host_disp = os.environ.get("SC7_HOST_WAYLAND_DISPLAY", "")
    rack_disp = ""
    is_running = False
    pid = None

    try:
        out = subprocess.check_output(["pgrep", "-a", "-f", "sc7-clipboard-bridge"], text=True)
        for line in out.strip().splitlines():
            if "sc7-clipboard-bridge" in line:
                is_running = True
                parts = line.split()
                if parts and parts[0].isdigit():
                    pid = int(parts[0])
                if "--host" in parts:
                    host_disp = parts[parts.index("--host") + 1]
                if "--nested" in parts:
                    rack_disp = parts[parts.index("--nested") + 1]
                break
    except Exception:
        pass

    if not host_disp or not rack_disp:
        rundir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        try:
            sockets = [s for s in os.listdir(rundir) if s.startswith("wayland-") and not s.endswith(".lock")]
            sockets.sort()
            if len(sockets) >= 2:
                host_disp = host_disp or sockets[0]
                rack_disp = rack_disp or sockets[1]
            elif len(sockets) == 1:
                host_disp = host_disp or sockets[0]
                rack_disp = rack_disp or "active"
        except Exception:
            pass

    return {
        "running": is_running,
        "pid": pid,
        "host": host_disp or "auto-detect",
        "rack": rack_disp or "auto-detect"
    }

def sync_live_bridge(enable):
    rack = get_rack_status()
    if not rack["running"]:
        return

    bridge = get_bridge_status()
    if not enable and bridge["running"]:
        subprocess.run(["pkill", "-f", "sc7-clipboard-bridge"], stderr=subprocess.DEVNULL)
    elif enable and not bridge["running"]:
        bridge_bin = shutil.which("sc7-clipboard-bridge")
        if not bridge_bin:
            bridge_bin = os.path.join(PROJECT_ROOT, "bin/sc7-clipboard-bridge")
        if not os.path.exists(bridge_bin):
            bridge_bin = os.path.expanduser("~/.local/bin/sc7-clipboard-bridge")
        if os.path.exists(bridge_bin):
            args = [bridge_bin]
            host = os.environ.get("SC7_HOST_WAYLAND_DISPLAY", "")
            nested = os.environ.get("WAYLAND_DISPLAY", "")
            if host:
                args.extend(["--host", host])
            if nested:
                args.extend(["--nested", nested])
            subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def print_status(settings):
    rack = get_rack_status()
    bridge = get_bridge_status()
    autostart_mark = "[x]" if settings.get("autostart") else "[ ]"
    clipboard_mark = "[x]" if settings.get("share_clipboard") else "[ ]"

    print("========================================")
    print("        SC7Labs Rack Settings")
    print("========================================")
    print(f"Status:                      {'Running (PID ' + str(rack['pid']) + ')' if rack['running'] else 'Stopped'}")
    print(f"{autostart_mark} Start SC7Labs Rack at login: {'Enabled' if settings.get('autostart') else 'Disabled'}")
    print(f"{clipboard_mark} Share clipboard with desktop: {'Enabled' if settings.get('share_clipboard') else 'Disabled'}")
    print(f"Files path:                  {settings.get('files_path', DEFAULT_SETTINGS['files_path'])}")
    print(f"GPU Provider:                {settings.get('gpu_provider', 'auto')}")
    if settings.get("gpu_custom_command"):
        print(f"GPU Command:                 {settings.get('gpu_custom_command')}")
    print("----------------------------------------")
    print(f"Clipboard bridge:            {'Connected (PID ' + str(bridge['pid']) + ')' if bridge['running'] else 'Disconnected'}")
    print(f"Host Wayland:                {bridge['host']}")
    print(f"Rack Wayland:                {bridge['rack']}")
    print("========================================")

def show_gui(settings):
    if not HAS_TKINTER:
        msg = (
            "Error: Python Tkinter (python3-tk) is not installed.\n"
            "The SC7Labs Rack Settings graphical interface requires Tkinter.\n\n"
            "To install it, run:\n"
            "  sudo apt install python3-tk      (Debian / Ubuntu / Pop!_OS)\n"
            "  sudo dnf install python3-tkinter (Fedora)\n"
            "  sudo pacman -S tk                (Arch Linux)\n\n"
            "You can also manage settings via CLI:\n"
            "  sc7-rack-settings --status\n"
            "  sc7-rack-settings --help\n"
        )
        print(msg, file=sys.stderr)
        if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
            if shutil.which("notify-send"):
                subprocess.run([
                    "notify-send",
                    "SC7Labs Rack Settings",
                    "python3-tk is required to open Settings GUI.\nRun: sudo apt install python3-tk",
                    "--icon=dialog-error"
                ], stderr=subprocess.DEVNULL)
        sys.exit(1)

    root = tk.Tk()
    root.title("SC7Labs Rack Settings")
    root.geometry("540x590")
    root.minsize(500, 560)

    # Dark Theme Colors
    BG_COLOR = "#181b24"
    CARD_BG = "#202534"
    BORDER_COLOR = "#2e3549"
    TEXT_MAIN = "#f2f4f8"
    TEXT_MUTED = "#9aa3b6"
    ACCENT_TEAL = "#38c7bd"
    ACCENT_BLUE = "#3a75e8"
    GREEN_COLOR = "#2ee59d"
    RED_COLOR = "#ff5f56"

    root.configure(bg=BG_COLOR)

    # Window Icon
    if os.path.exists(ICON_PATH):
        try:
            icon_img = tk.PhotoImage(file=ICON_PATH)
            root.iconphoto(True, icon_img)
        except Exception:
            pass

    # Styling
    style = ttk.Style()
    style.theme_use("clam")
    style.configure(".", background=BG_COLOR, foreground=TEXT_MAIN, font=("sans-serif", 10))

    # Main Scrollable / Padded Container
    container = tk.Frame(root, bg=BG_COLOR, padx=24, pady=20)
    container.pack(fill=tk.BOTH, expand=True)

    # 1. Header Card
    header_frame = tk.Frame(container, bg=CARD_BG, highlightbackground=BORDER_COLOR,
                            highlightthickness=1, padx=16, pady=14)
    header_frame.pack(fill=tk.X, pady=(0, 16))

    header_left = tk.Frame(header_frame, bg=CARD_BG)
    header_left.pack(side=tk.LEFT, fill=tk.Y)

    title_label = tk.Label(header_left, text="SC7Labs Rack", font=("sans-serif", 16, "bold"),
                           fg=TEXT_MAIN, bg=CARD_BG)
    title_label.pack(anchor="w")

    subtitle_label = tk.Label(header_left, text="Nested Compositor & Developer Workspace",
                              font=("sans-serif", 9), fg=TEXT_MUTED, bg=CARD_BG)
    subtitle_label.pack(anchor="w")

    # Status Pill on the Right
    rack = get_rack_status()
    is_running = rack["running"]
    status_text = f"● Active (PID {rack['pid']})" if is_running else "○ Stopped"
    status_fg = GREEN_COLOR if is_running else TEXT_MUTED

    status_pill = tk.Label(header_frame, text=status_text, font=("sans-serif", 9, "bold"),
                           fg=status_fg, bg="#131620", padx=10, pady=5,
                           highlightbackground=BORDER_COLOR, highlightthickness=1)
    status_pill.pack(side=tk.RIGHT, anchor="center")

    # 2. Options Card
    options_frame = tk.Frame(container, bg=CARD_BG, highlightbackground=BORDER_COLOR,
                             highlightthickness=1, padx=18, pady=16)
    options_frame.pack(fill=tk.X, pady=(0, 16))

    # Option 1: Start at login
    autostart_var = tk.BooleanVar(value=bool(settings.get("autostart", False)))

    chk_autostart = tk.Checkbutton(
        options_frame,
        text="Start SC7Labs Rack at login",
        variable=autostart_var,
        font=("sans-serif", 11, "bold"),
        fg=TEXT_MAIN,
        bg=CARD_BG,
        activebackground=CARD_BG,
        activeforeground=ACCENT_TEAL,
        selectcolor="#131620",
        relief=tk.FLAT,
        highlightthickness=0,
        bd=0
    )
    chk_autostart.pack(anchor="w")

    desc_autostart = tk.Label(
        options_frame,
        text="Automatically launches SC7Labs Rack when you log into your desktop session",
        font=("sans-serif", 9),
        fg=TEXT_MUTED,
        bg=CARD_BG
    )
    desc_autostart.pack(anchor="w", padx=(24, 0), pady=(0, 14))

    # Option 2: Share clipboard with desktop
    clipboard_var = tk.BooleanVar(value=bool(settings.get("share_clipboard", True)))

    chk_clipboard = tk.Checkbutton(
        options_frame,
        text="Share clipboard with desktop",
        variable=clipboard_var,
        font=("sans-serif", 11, "bold"),
        fg=TEXT_MAIN,
        bg=CARD_BG,
        activebackground=CARD_BG,
        activeforeground=ACCENT_TEAL,
        selectcolor="#131620",
        relief=tk.FLAT,
        highlightthickness=0,
        bd=0
    )
    chk_clipboard.pack(anchor="w")

    bridge_info = get_bridge_status()
    bridge_state = f"Connected ({bridge_info['host']} ⇄ {bridge_info['rack']})" if bridge_info["running"] else "Idle"
    desc_clipboard = tk.Label(
        options_frame,
        text=f"Seamless text and file copy/paste between host and rack (Status: {bridge_state})",
        font=("sans-serif", 9),
        fg=TEXT_MUTED,
        bg=CARD_BG
    )
    desc_clipboard.pack(anchor="w", padx=(24, 0), pady=(0, 14))

    # Divider Line
    sep = tk.Frame(options_frame, height=1, bg=BORDER_COLOR)
    sep.pack(fill=tk.X, pady=(2, 14))

    # Option 3: Files Path
    lbl_files = tk.Label(
        options_frame,
        text="Files path (COSMIC Files inside rack):",
        font=("sans-serif", 11, "bold"),
        fg=TEXT_MAIN,
        bg=CARD_BG
    )
    lbl_files.pack(anchor="w")

    desc_files = tk.Label(
        options_frame,
        text="Working directory opened by COSMIC Files in the top-right rack quadrant",
        font=("sans-serif", 9),
        fg=TEXT_MUTED,
        bg=CARD_BG
    )
    desc_files.pack(anchor="w", pady=(0, 8))

    path_frame = tk.Frame(options_frame, bg=CARD_BG)
    path_frame.pack(fill=tk.X)

    path_var = tk.StringVar(value=str(settings.get("files_path", DEFAULT_SETTINGS["files_path"])))

    entry_path = tk.Entry(
        path_frame,
        textvariable=path_var,
        font=("sans-serif", 10),
        fg=TEXT_MAIN,
        bg="#131620",
        insertbackground=TEXT_MAIN,
        relief=tk.FLAT,
        highlightbackground=BORDER_COLOR,
        highlightthickness=1
    )
    entry_path.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(0, 10), ipady=5)

    def on_browse():
        current_dir = path_var.get()
        if not os.path.isdir(current_dir):
            current_dir = os.path.expanduser("~")
        selected = filedialog.askdirectory(
            parent=root,
            initialdir=current_dir,
            title="Select COSMIC Files Directory"
        )
        if selected:
            path_var.set(selected)

    btn_browse = tk.Button(
        path_frame,
        text="Browse...",
        command=on_browse,
        font=("sans-serif", 9, "bold"),
        fg=TEXT_MAIN,
        bg="#2d3345",
        activebackground="#3b435b",
        activeforeground=TEXT_MAIN,
        relief=tk.FLAT,
        highlightthickness=0,
        padx=14,
        pady=6,
        cursor="hand2"
    )
    btn_browse.pack(side=tk.RIGHT)

    # Option 4: GPU Monitor Provider
    lbl_gpu = tk.Label(
        options_frame,
        text="GPU Monitor Provider",
        font=("sans-serif", 11, "bold"),
        fg=TEXT_MAIN,
        bg=CARD_BG
    )
    lbl_gpu.pack(anchor="w", pady=(14, 2))

    desc_gpu = tk.Label(
        options_frame,
        text="Hardware provider for top-left monitor (Intel Arc tested; NVIDIA/AMD future-proofed)",
        font=("sans-serif", 9),
        fg=TEXT_MUTED,
        bg=CARD_BG
    )
    desc_gpu.pack(anchor="w", pady=(0, 8))

    gpu_frame = tk.Frame(options_frame, bg=CARD_BG)
    gpu_frame.pack(fill=tk.X)

    gpu_var = tk.StringVar(value=str(settings.get("gpu_provider", "auto")))
    gpu_choices = ["auto", "intel", "nvidia", "amd", "custom"]
    gpu_menu = ttk.Combobox(gpu_frame, textvariable=gpu_var, values=gpu_choices, state="readonly", width=12)
    gpu_menu.pack(side=tk.LEFT, padx=(0, 10))

    gpu_cmd_var = tk.StringVar(value=str(settings.get("gpu_custom_command", "")))
    entry_gpu_cmd = tk.Entry(
        gpu_frame,
        textvariable=gpu_cmd_var,
        font=("sans-serif", 10),
        fg=TEXT_MAIN,
        bg="#131620",
        insertbackground=TEXT_MAIN,
        relief=tk.FLAT,
        highlightbackground=BORDER_COLOR,
        highlightthickness=1
    )

    def on_gpu_change(event=None):
        if gpu_var.get() == "custom":
            entry_gpu_cmd.pack(side=tk.LEFT, fill=tk.X, expand=True, ipady=5)
        else:
            entry_gpu_cmd.pack_forget()

    gpu_menu.bind("<<ComboboxSelected>>", on_gpu_change)
    if gpu_var.get() == "custom":
        entry_gpu_cmd.pack(side=tk.LEFT, fill=tk.X, expand=True, ipady=5)

    # Toast / Message Label
    toast_label = tk.Label(container, text="", font=("sans-serif", 9, "bold"), fg=GREEN_COLOR, bg=BG_COLOR)
    toast_label.pack(pady=(4, 8))

    def show_toast(msg, is_error=False):
        toast_label.config(text=msg, fg=RED_COLOR if is_error else GREEN_COLOR)
        root.after(3500, lambda: toast_label.config(text=""))

    # 3. Actions / Bottom Bar
    actions_frame = tk.Frame(container, bg=BG_COLOR)
    actions_frame.pack(fill=tk.X, side=tk.BOTTOM, pady=(8, 0))

    # Rack control toggle button on left
    def toggle_rack():
        rack_bin = shutil.which("sc7-rack")
        if not rack_bin or not os.path.exists(rack_bin):
            for cand in [os.path.join(PROJECT_ROOT, "bin/sc7-rack"), os.path.expanduser("~/.local/bin/sc7-rack"), os.path.expanduser("~/bin/sc7-rack")]:
                if os.path.exists(cand):
                    rack_bin = cand
                    break
        rack_bin = rack_bin or "sc7-rack"

        r = get_rack_status()
        if r["running"]:
            try:
                subprocess.run([rack_bin, "--stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                show_toast("Stopping SC7Labs Rack...")
                root.after(1000, refresh_status)
            except Exception as e:
                show_toast(f"Error stopping: {e}", is_error=True)
        else:
            try:
                subprocess.Popen([rack_bin], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                show_toast("Starting SC7Labs Rack...")
                root.after(1500, refresh_status)
            except Exception as e:
                show_toast(f"Error launching: {e}", is_error=True)

    btn_rack_toggle = tk.Button(
        actions_frame,
        text="Stop Rack" if is_running else "Launch Rack",
        command=toggle_rack,
        font=("sans-serif", 9),
        fg=TEXT_MUTED,
        bg="#222634",
        activebackground="#2e3549",
        activeforeground=TEXT_MAIN,
        relief=tk.FLAT,
        highlightthickness=1,
        highlightbackground=BORDER_COLOR,
        padx=12,
        pady=6,
        cursor="hand2"
    )
    btn_rack_toggle.pack(side=tk.LEFT)

    def refresh_status():
        r = get_rack_status()
        if r["running"]:
            status_pill.config(text=f"● Active (PID {r['pid']})", fg=GREEN_COLOR)
            btn_rack_toggle.config(text="Stop Rack")
        else:
            status_pill.config(text="○ Stopped", fg=TEXT_MUTED)
            btn_rack_toggle.config(text="Launch Rack")

    # Right side buttons: Close, Save & Apply
    def on_close():
        root.destroy()

    def on_save():
        path_val = path_var.get().strip()
        if not path_val:
            show_toast("Files path cannot be empty", is_error=True)
            return
        expanded_path = os.path.expanduser(path_val)
        if not os.path.exists(expanded_path):
            try:
                os.makedirs(expanded_path, exist_ok=True)
            except Exception as e:
                show_toast(f"Cannot create directory: {e}", is_error=True)
                return

        settings["autostart"] = autostart_var.get()
        settings["share_clipboard"] = clipboard_var.get()
        settings["files_path"] = path_val
        settings["gpu_provider"] = gpu_var.get()
        settings["gpu_custom_command"] = gpu_cmd_var.get().strip()

        save_settings(settings)
        show_toast("✓ Settings saved and applied successfully")
        refresh_status()

    btn_save = tk.Button(
        actions_frame,
        text="Save & Apply",
        command=on_save,
        font=("sans-serif", 9, "bold"),
        fg="#ffffff",
        bg=ACCENT_BLUE,
        activebackground="#4a85f8",
        activeforeground="#ffffff",
        relief=tk.FLAT,
        highlightthickness=0,
        padx=16,
        pady=6,
        cursor="hand2"
    )
    btn_save.pack(side=tk.RIGHT, padx=(8, 0))

    btn_close = tk.Button(
        actions_frame,
        text="Close",
        command=on_close,
        font=("sans-serif", 9),
        fg=TEXT_MAIN,
        bg="#222634",
        activebackground="#2e3549",
        activeforeground=TEXT_MAIN,
        relief=tk.FLAT,
        highlightthickness=1,
        highlightbackground=BORDER_COLOR,
        padx=14,
        pady=6,
        cursor="hand2"
    )
    btn_close.pack(side=tk.RIGHT)

    # Key Bindings
    root.bind("<Escape>", lambda e: on_close())
    root.bind("<Control-s>", lambda e: on_save())
    root.bind("<Control-S>", lambda e: on_save())

    # Periodically check status
    def poll():
        refresh_status()
        root.after(3000, poll)

    root.after(3000, poll)
    root.mainloop()

def main():
    settings = load_settings()
    args = sys.argv[1:]

    if not args:
        if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"):
            show_gui(settings)
        else:
            print_status(settings)
        return

    if "--gui" in args:
        show_gui(settings)
        return

    if "--status" in args or "status" in args:
        print_status(settings)
        return

    changed = False
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--autostart":
            if i + 1 < len(args) and args[i+1].lower() in ("on", "true", "1", "yes"):
                settings["autostart"] = True
                i += 1
            elif i + 1 < len(args) and args[i+1].lower() in ("off", "false", "0", "no"):
                settings["autostart"] = False
                i += 1
            else:
                settings["autostart"] = not settings.get("autostart", False)
            changed = True
        elif arg == "--share-clipboard":
            if i + 1 < len(args) and args[i+1].lower() in ("on", "true", "1", "yes"):
                settings["share_clipboard"] = True
                i += 1
            elif i + 1 < len(args) and args[i+1].lower() in ("off", "false", "0", "no"):
                settings["share_clipboard"] = False
                i += 1
            else:
                settings["share_clipboard"] = not settings.get("share_clipboard", True)
            changed = True
        elif arg == "--files-path" and i + 1 < len(args):
            settings["files_path"] = args[i+1]
            i += 1
            changed = True
        elif arg == "--gpu-provider" and i + 1 < len(args):
            prov = args[i+1].lower()
            if prov in ("auto", "intel", "nvidia", "amd", "custom"):
                settings["gpu_provider"] = prov
                changed = True
            else:
                print(f"Error: Invalid GPU provider '{prov}'. Valid: auto, intel, nvidia, amd, custom", file=sys.stderr)
                return
            i += 1
        elif arg == "--gpu-command" and i + 1 < len(args):
            settings["gpu_custom_command"] = args[i+1]
            i += 1
            changed = True
        elif arg in ("--help", "-h"):
            print("Usage: sc7-rack-settings [OPTIONS]")
            print("  --gui                          Open graphical settings dialog")
            print("  --status                       Print current settings and status")
            print("  --autostart [on|off]           Configure Start at login")
            print("  --share-clipboard [on|off]      Configure desktop clipboard sharing")
            print("  --files-path <path>            Set path for nested COSMIC Files")
            print("  --gpu-provider <auto|intel|nvidia|amd|custom>  Set GPU monitor provider")
            print("  --gpu-command '<cmd>'          Set custom GPU monitor command")
            return
        i += 1

    if changed:
        save_settings(settings)
        print("Updated settings:")
    print_status(settings)

if __name__ == "__main__":
    main()
